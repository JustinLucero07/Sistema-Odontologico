# Backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/storage/
backend/.env
backend/*.egg-info/

# Frontend (Angular)
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Infra
infra/.env
infra/backups/*
!infra/backups/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store

# Respaldos: contienen la base de datos completa con historias clínicas.
# Nunca deben acabar en el control de versiones.
backups/
*.dump
*.dump.SOSPECHOSO
infra/.env.prod
infra/respaldos/

# Material de promoción pesado (se regenera con docs/promocion/fuente)
docs/promocion/*.mp4
docs/promocion/escenas/
docs/promocion/capturas/
docs/promocion/fuente/*.wav
docs/promocion/fuente/clips/
