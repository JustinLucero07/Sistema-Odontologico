# Copie este archivo como .env.prod y complete los valores.
# NUNCA lo suba a un repositorio: contiene las claves de la clínica.

# Dominio donde se servirá el sistema (debe apuntar a este servidor).
DOMINIO=clinica.ejemplo.com
# Correo para avisos del certificado HTTPS (Let's Encrypt).
CORREO_TLS=soporte@ejemplo.com

# Genere cada clave con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Respaldos automáticos
RETENCION_DIAS=30
HORA_RESPALDO=02

# Opcionales
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ANTHROPIC_API_KEY=
