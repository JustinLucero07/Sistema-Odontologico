# Copie este archivo como .env.prod y complete los valores.
# NUNCA lo suba a un repositorio: contiene las claves de la clínica.

# Dominio donde se servirá el sistema (debe apuntar a este servidor).
DOMINIO=clinica.ejemplo.com
# Correo para avisos del certificado HTTPS (Let's Encrypt).
CORREO_TLS=soporte@ejemplo.com

# Genere cada clave con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Respaldos automáticos
RETENCION_DIAS=30
HORA_RESPALDO=02
# Días que se guardan los respaldos en la nube (copia fuera del servidor).
RETENCION_EXTERNA_DIAS=90

# Su empresa (sale en los Términos de uso y el contrato de encargo de datos).
PROVIDER_NAME="el proveedor del sistema"
PROVIDER_TAX_ID=
PROVIDER_EMAIL=

# Procesos del backend: 2 para un VPS de 2 GB; 4 si tiene 4 GB o más.
WEB_WORKERS=2

# Opcionales
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ANTHROPIC_API_KEY=

# --- Facturación electrónica (SRI) ---
# Llave con la que se cifran las firmas .p12 de las consultas. Genérela una vez
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# y NO la cambie: si cambia, cada consulta debe volver a subir su firma.
# Vacía = se deriva de JWT_SECRET_KEY.
CERT_ENCRYPTION_KEY=
# Correo saliente para enviar las facturas a los pacientes (opcional).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
