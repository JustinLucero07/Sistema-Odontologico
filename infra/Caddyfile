# HTTPS automático: Caddy obtiene y renueva el certificado de Let's Encrypt
# para el dominio. Requisito: el dominio apunta a este servidor y los puertos
# 80 y 443 están abiertos.
{
	email {$CORREO_TLS}
}

{$DOMINIO} {
	encode zstd gzip

	# Radiografías y documentos de hasta 25 MB.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Solo se ejecuta el código del propio sistema: un texto o archivo con
		# código que alguien lograra guardar no puede correr en el navegador.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}
}
